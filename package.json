{
  "name": "precificador-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "migrate:create": "node-pg-migrate create --migrations-dir server/migrations --envPath server/.env",
    "migrate:up": "node-pg-migrate up --migrations-dir server/migrations --envPath server/.env",
    "migrate:down": "node-pg-migrate down --migrations-dir server/migrations --envPath server/.env",
    "db:bootstrap": "node server/scripts/bootstrapDatabase.js",
    "ncm:check": "node server/scripts/ncmCatalog.js check",
    "ncm:update": "node server/scripts/ncmCatalog.js update",
    "seed:marketplaces": "node server/seedMarketplaces.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "pg": "^8.19.0",
    "pg-copy-streams": "^7.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
